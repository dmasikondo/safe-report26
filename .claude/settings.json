            "PowerShell(npm:*)",
            "PowerShell(npx:*)",
            "PowerShell(git status)",
            "PowerShell(git diff:*)",
            "PowerShell(git log:*)",
            "PowerShell(git add:*)",
            "PowerShell(git commit:*)"
        ],
        "deny": [
            "Bash(rm -rf:*)",
